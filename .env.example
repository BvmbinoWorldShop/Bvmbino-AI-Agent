# ════════════════════════════════════════════════
#   BVMBINO AI AGENT — ALL API KEYS
# ════════════════════════════════════════════════
# Copy this to .env.local for local dev
# Add each to Vercel: Settings → Environment Variables

# ── REQUIRED ─────────────────────────────────────
# Claude AI — chat, resume, strategy, campaigns
# Get: console.anthropic.com → API Keys
# Cost: ~$0.003/message (Sonnet 4)
ANTHROPIC_KEY=sk-ant-api03-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ── IMAGE GENERATION ─────────────────────────────
# Together AI — Flux image generation
# Get: api.together.xyz → Settings → API Keys
# Free: $1 credit on signup + FLUX.1-schnell-Free is FREE
TOGETHER_KEY=your-together-api-key-here

# ── WEB SEARCH ───────────────────────────────────
# Brave Search API — real web search
# Get: api.search.brave.com → Create App
# Free: 2,000 queries/month NO CREDIT CARD
BRAVE_KEY=BSAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── PDF EXPORT ───────────────────────────────────
# PDFShift — styled PDF generation
# Get: pdfshift.io → Sign up free
# Free: 50 PDFs/month
PDFSHIFT_KEY=sk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── WEB SCRAPING ─────────────────────────────────
# Jina AI Reader — scrape any URL to clean markdown
# NO KEY NEEDED — free, works automatically
# Optional paid key for higher limits: jina.ai
# JINA_KEY=jina_xxxxxxxxxxxxxxxxxxxxxxxx

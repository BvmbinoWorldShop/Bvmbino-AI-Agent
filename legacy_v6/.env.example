# ════════════════════════════════════════════════
#   BVMBINO AI AGENT — API KEYS
#   Copy to .env for local dev
#   Add each to Vercel: Settings → Environment Variables
# ════════════════════════════════════════════════

# ── PRIMARY AI (REQUIRED — pick at least one) ────
# Gemini Flash — main AI model
# Get FREE key: aistudio.google.com → Get API Key
# Free tier: 15 req/min, 1M tokens/day, 1500 req/day
GEMINI_KEY=your-gemini-key-here

# Second Gemini key — OPTIONAL, doubles your free quota
# Get another free key at aistudio.google.com (different Google account)
# GEMINI_KEY_2=your-second-gemini-key-here

# ── FALLBACK AI (RECOMMENDED — free forever) ─────
# Groq — Llama 3.3 70B, blazing fast, completely free
# Get FREE key: console.groq.com → Create API Key
# Free tier: 14,400 req/day, 6000 tokens/min — no credit card
# GROQ_KEY=your-groq-key-here

# ── PDF EXPORT ───────────────────────────────────
# PDFShift — styled PDF generation
# Get: pdfshift.io → Sign up free (no credit card)
# Free: 50 PDFs/month
PDFSHIFT_KEY=sk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── WEB SCRAPING & SEARCH ────────────────────────
# Jina AI Reader — NO KEY NEEDED, free automatic
# DuckDuckGo search — NO KEY NEEDED, free
